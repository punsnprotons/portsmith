{
  "name": "portsmith-workbench",
  "version": "0.6.0-alpha.2",
  "description": "Move JavaScript and TypeScript features between repositories with behavior checks and reviewable patches.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "docs",
    "examples",
    "scripts/demo.mjs",
    "scripts/fixture.mjs",
    "scripts/browser-fixture.mjs",
    "scripts/demo-browser.mjs",
    "scripts/demo-autonomous.mjs",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "portsmith.model.json",
    ".env.example",
    "scripts/run-demo.mjs",
    "skills"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "bin": {
    "portsmith": "./src/cli.mjs",
    "portsmith-demo": "./scripts/run-demo.mjs",
    "portsmith-mcp": "./src/mcp.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "mcp": "node src/mcp.mjs",
    "doctor": "node src/cli.mjs doctor",
    "check": "npm run test:types && npm test && npm run docs:check",
    "test:types": "tsc -p test/types/tsconfig.json",
    "docs:generate": "node scripts/generate-reference.mjs",
    "docs:check": "node scripts/generate-reference.mjs --check",
    "demo:autonomous": "node --env-file=.env scripts/demo-autonomous.mjs",
    "browser:install": "playwright install chromium",
    "demo:browser": "node scripts/demo-browser.mjs",
    "format": "prettier --write src scripts test",
    "release:check": "node scripts/release-check.mjs",
    "release:clean": "node scripts/release-check.mjs --clean",
    "audit:release": "node scripts/audit-dependencies.mjs",
    "release:published": "node scripts/release-check.mjs --clean --published",
    "demo:prepare": "node scripts/create-example.mjs",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vitest": "0.34.0",
    "vitest-modern": "npm:vitest@4.1.11"
  },
  "keywords": [
    "feature-transfer",
    "code-reuse",
    "code-migration",
    "verification",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "developer-tools",
    "cli",
    "typescript",
    "javascript",
    "software-testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punsnprotons/portsmith.git"
  },
  "bugs": {
    "url": "https://github.com/punsnprotons/portsmith/issues"
  },
  "homepage": "https://github.com/punsnprotons/portsmith#readme",
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
